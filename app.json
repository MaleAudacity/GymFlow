{
  "expo": {
    "name": "GymFlow - Gym CRM & Attendance",
    "slug": "gymflow",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "gymflow",
    "newArchEnabled": false,
    "splash": {
      "backgroundColor": "#4F46E5"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.gymflow.app"
    },
    "android": {
      "package": "com.gymflow.app",
      "versionCode": 2,
      "adaptiveIcon": {
        "foregroundImage": "./assets/gymflow_logo.png",
        "backgroundColor": "#4F46E5"
      },
      "permissions": [
        "CAMERA",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE"
      ]
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Allow GymFlow to scan member QR codes for fast check-in."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow GymFlow to access photos for gym logo and member photos."
        }
      ],
      "expo-sqlite",
      "expo-secure-store",
      "expo-font",
      "expo-asset"
    ]
  }
}
